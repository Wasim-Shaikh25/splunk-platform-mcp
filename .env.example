# --- Splunk Dashboard MCP configuration ---
# Copy to .env for local `npm run login` / `npm run validate`, OR set these under
# your MCP server env block in mcp.json (Cursor/Kiro). Secrets (SPLUNK_TOKEN) should
# come only from the MCP config, never a committed .env.

# Base URL of your Splunk web tier (the host you open in a browser). No trailing slash.
# Example: https://splunk.disney.com
SPLUNK_BASE_URL=

# Page to open for SSO login. Defaults to SPLUNK_BASE_URL + "/en-US/account/login".
# SPLUNK_LOGIN_URL=

# How REST calls reach splunkd. The server probes candidates after login, but you can pin one:
#   proxy   -> {base}/{locale}/splunkd/__raw        (web tier proxies to splunkd on 443; works with SSO cookies)
#   mgmt    -> {base host}:8089                      (direct management port; often firewalled, may reject web SSO cookies)
# SPLUNK_REST_MODE=proxy

# Locale segment used in the proxy path. Default en-US.
# SPLUNK_LOCALE=en-US

# Management port for mgmt mode. Default 8089.
# SPLUNK_MGMT_PORT=8089

# Owner namespace for create (defaults to the logged-in user detected from Splunk).
# Only set to override; new dashboards are created under this owner.
# SPLUNK_OWNER=

# Default app namespace for create/list when not specified per call. Default "search".
# SPLUNK_DEFAULT_APP=search

# Login wait / poll tuning
# SPLUNK_LOGIN_WAIT_SECONDS=90
# SPLUNK_LOGIN_POLL_MS=2000

# Background session keep-alive interval (seconds). Default 240. Set 0 to disable.
# SPLUNK_KEEPALIVE_SECONDS=240

# Disambiguates the cookie file + mcp.json server block when multiple servers point here.
# SPLUNK_MCP_SERVER_KEY=
